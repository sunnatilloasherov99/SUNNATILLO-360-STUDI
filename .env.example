# Copy this file to .env and replace the placeholder password before deployment.
POSTGRES_DB=studio
POSTGRES_USER=studio
POSTGRES_PASSWORD=replace-with-a-long-random-password
WEB_PORT=8080
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:8080
ENVIRONMENT=production
MAX_UPLOAD_MB=100
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
TOKEN_EXPIRE_HOURS=24
# Optional free local AI. Install Ollama separately to enable it.
# For Docker on a host with Ollama, use http://host.docker.internal:11434
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=120
