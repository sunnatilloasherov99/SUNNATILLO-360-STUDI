# Copy to infra/.env. Replace every placeholder before public deployment.
ENVIRONMENT=production
FRONTEND_ORIGIN=https://your-domain.example
WEB_PORT=8080
API_PORT=8000
POSTGRES_DB=studio
POSTGRES_USER=studio
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
MAX_UPLOAD_MB=100
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
TOKEN_EXPIRE_HOURS=24

# Optional free local AI. Leave blank to keep AI disabled.
# For Ollama running on the Docker host, use http://host.docker.internal:11434
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=120

# Redis is internal to Docker Compose and stores shared request rate limits.
RATE_LIMIT_STORAGE_URI=redis://redis:6379/0
